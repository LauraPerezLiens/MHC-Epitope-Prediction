# Datasets: keep only their documentation
/data/*
!/data/README.md
!/data/used_data/
/data/used_data/*
!/data/used_data/README.md

# Pretrained weights, experiment outputs and historical code copies
/model/
/results/*
!/results/README.md

# Operational logs: keep documentation
/logs/*
!/logs/README.md

